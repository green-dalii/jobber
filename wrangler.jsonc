{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "jobber",
    "main": "./dist/_worker.js/index.js",
    "compatibility_date": "2024-09-23",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}