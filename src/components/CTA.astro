---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-32 relative">
  <div class="absolute inset-0 bg-primary-100 dark:bg-primary-950 -skew-y-3 transform origin-bottom-right scale-110 pointer-events-none"></div>
  
  <div class="container mx-auto px-6 relative z-10 text-center">
    <div class="max-w-4xl mx-auto glass-card p-12 md:p-20 border-primary-200 dark:border-primary-900 bg-white/80 dark:bg-gray-900/80 shadow-2xl backdrop-blur-xl">
      <h2 class="text-4xl md:text-6xl font-black mb-8 tracking-tight">
        {t('cta.title.1')} <span class="text-primary italic">{t('cta.title.2')}</span>
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-400 mb-12 max-w-2xl mx-auto">
        {t('cta.subtitle')}
      </p>
      
      <form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto">
        <input 
          type="email" 
          placeholder={t('cta.placeholder')} 
          class="flex-1 px-6 py-4 rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 focus:outline-none focus:border-primary transition-colors shadow-inner"
          required
        />
        <button type="submit" class="btn-primary whitespace-nowrap">
          {t('cta.button')}
        </button>
      </form>
      
      <p class="mt-6 text-sm text-gray-500">
        {t('cta.note')}
      </p>
    </div>
  </div>
</section>
