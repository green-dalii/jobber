---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
  <!-- Background Decorations -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-primary/20 rounded-full blur-[120px] animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary-dark dark:text-primary font-medium text-sm mb-8 animate-fade-in shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
      </span>
      {t('hero.badge')}
    </div>

    <!-- Main Heading -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 tracking-tight animate-slide-up bg-clip-text text-transparent bg-gradient-to-b from-gray-900 to-gray-600 dark:from-white dark:to-gray-400">
      {t('hero.title.1')} <br />
      {t('hero.title.2')} <span class="text-primary italic">{t('hero.title.3')}</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10 animate-slide-up" style="animation-delay: 0.2s;">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.4s;">
      <a href="/get-started" class="btn-primary w-full sm:w-auto text-lg group">
        {t('hero.cta.start')}
        <svg class="inline-block w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="#features" class="btn-outline w-full sm:w-auto text-lg">
        {t('hero.cta.explore')}
      </a>
    </div>

    <!-- Mockup / Visual -->
    <div class="mt-20 relative animate-slide-up" style="animation-delay: 0.6s;">
      <div class="mx-auto max-w-4xl glass-card p-4 overflow-hidden shadow-2xl">
        <div class="flex gap-2 mb-4 border-b border-white/10 pb-4">
          <div class="w-3 h-3 rounded-full bg-red-400"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
          <div class="w-3 h-3 rounded-full bg-green-400"></div>
        </div>
        <div class="space-y-4">
          <div class="h-8 bg-gray-200 dark:bg-gray-800 rounded w-1/3"></div>
          <div class="h-40 bg-gray-100 dark:bg-gray-900 rounded flex items-center justify-center border border-dashed border-gray-300 dark:border-gray-700">
              <span class="text-gray-400 dark:text-gray-600 italic">{t('hero.mockup.agent')}</span>
          </div>
          <div class="grid grid-cols-3 gap-4">
            <div class="h-12 bg-gray-200 dark:bg-gray-800 rounded"></div>
            <div class="h-12 bg-gray-200 dark:bg-gray-800 rounded"></div>
            <div class="h-12 bg-primary/20 rounded border border-primary/30 flex items-center justify-center text-primary font-bold">{t('hero.mockup.match')}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
