---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="relative min-h-screen flex items-center justify-center pt-20 overflow-hidden">
  <!-- Background Decorations -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-primary/20 rounded-full blur-[120px] animate-pulse" style="animation-delay: 1s;"></div>
  </div>

  <div class="container mx-auto px-6 relative z-10 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 border border-primary/20 text-primary-dark dark:text-primary font-medium text-sm mb-8 animate-fade-in shadow-sm">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
      </span>
      {t('hero.badge')}
    </div>

    <!-- Main Heading -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6 tracking-tight animate-slide-up bg-clip-text text-transparent bg-gradient-to-b from-gray-900 to-gray-600 dark:from-white dark:to-gray-400">
      {t('hero.title.1')} <br />
      {t('hero.title.2')} <span class="text-primary italic">{t('hero.title.3')}</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10 animate-slide-up" style="animation-delay: 0.2s;">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.4s;">
      <a href="/get-started" class="btn-primary w-full sm:w-auto text-lg group">
        {t('hero.cta.start')}
        <svg class="inline-block w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="#features" class="btn-outline w-full sm:w-auto text-lg">
        {t('hero.cta.explore')}
      </a>
    </div>

    <!-- Mockup / Visual -->
    <div class="mt-20 relative animate-slide-up" style="animation-delay: 0.6s;">
      <div class="mx-auto max-w-5xl glass-card p-2 overflow-hidden shadow-2xl border-white/20 relative group">
        <!-- Top Bar -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-white/10 glass-card rounded-none rounded-t-xl mb-1">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-red-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-500/50"></div>
          </div>
          <div class="text-[10px] text-gray-500 font-mono tracking-widest uppercase flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
            Agent Active: v2.4.0
          </div>
        </div>

        <div class="flex flex-col md:flex-row h-[400px] gap-1 bg-black/20">
          <!-- Left: Job Feed Marquee -->
          <div class="w-full md:w-1/3 border-r border-white/5 relative overflow-hidden hidden md:block">
            <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-black/20 pointer-events-none z-10"></div>
            <div class="flex flex-col gap-2 p-2 animate-marquee">
              {[...Array(10)].map((_, i) => (
                <div class="p-3 glass-card border-none bg-white/5 rounded-lg space-y-2 opacity-40 hover:opacity-100 transition-opacity">
                  <div class="h-3 bg-gray-700/50 rounded w-3/4"></div>
                  <div class="h-2 bg-gray-800/50 rounded w-1/2"></div>
                  <div class="flex justify-between items-center">
                    <div class="h-2 bg-gray-800/50 rounded w-1/4"></div>
                    <div class="text-[8px] text-primary/40 font-mono">SCANNED</div>
                  </div>
                </div>
              ))}
              {[...Array(10)].map((_, i) => (
                <div class="p-3 glass-card border-none bg-white/5 rounded-lg space-y-2 opacity-40 hover:opacity-100 transition-opacity">
                  <div class="h-3 bg-gray-700/50 rounded w-3/4"></div>
                  <div class="h-2 bg-gray-800/50 rounded w-1/2"></div>
                  <div class="flex justify-between items-center">
                    <div class="h-2 bg-gray-800/50 rounded w-1/4"></div>
                    <div class="text-[8px] text-primary/40 font-mono">SCANNED</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Center/Right: Detailed Analysis -->
          <div class="flex-1 p-6 flex flex-col items-center justify-center relative bg-gradient-to-br from-primary/5 to-transparent">
            <!-- Brain/Core Icon -->
            <div class="relative mb-8">
              <div class="absolute inset-0 bg-primary/20 blur-2xl rounded-full scale-150 animate-pulse-glow"></div>
              <div class="w-20 h-20 bg-primary rounded-3xl flex items-center justify-center transform rotate-12 shadow-primary/20 shadow-2xl relative z-10">
                <svg class="w-10 h-10 text-black animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
            </div>

            <!-- Matching Progress -->
            <div class="w-full max-w-sm space-y-4">
              <div class="flex justify-between items-end">
                <div class="space-y-1">
                  <h4 class="text-xs font-bold font-mono text-gray-400 uppercase tracking-tighter">Analyzing Alignment</h4>
                  <p class="text-sm font-medium">{t('hero.mockup.agent')}</p>
                </div>
                <div class="text-2xl font-black text-primary font-mono tabular-nums animate-pulse">98.4%</div>
              </div>
              
              <div class="h-1.5 w-full bg-gray-800 rounded-full overflow-hidden">
                <div class="h-full bg-primary animate-progress-fill shadow-[0_0_15px_rgba(151,221,30,0.5)]"></div>
              </div>

              <!-- Recommendation Card -->
              <div class="mt-8 p-4 glass-card bg-primary/10 border-primary/20 flex gap-4 animate-slide-up" style="animation-delay: 1.5s;">
                <div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center shrink-0">
                  <div class="w-6 h-6 bg-gray-600 rounded"></div>
                </div>
                <div class="flex-1 space-y-2">
                  <div class="flex justify-between items-start">
                    <div class="h-3 bg-gray-200 dark:bg-gray-400 rounded w-1/2"></div>
                    <div class="px-2 py-0.5 rounded bg-primary text-[8px] font-bold text-black uppercase">{t('hero.mockup.match')}</div>
                  </div>
                  <div class="h-2 bg-gray-300 dark:bg-gray-700 rounded w-1/3"></div>
                  <div class="flex gap-2 pt-2">
                    <div class="h-4 bg-primary/20 rounded w-16 border border-primary/30"></div>
                    <div class="h-4 bg-primary/20 rounded w-20 border border-primary/30"></div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Decoration Lines -->
            <div class="absolute top-10 left-10 w-20 h-px bg-gradient-to-r from-transparent to-primary/20"></div>
            <div class="absolute bottom-10 right-10 w-20 h-px bg-gradient-to-l from-transparent to-primary/20"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
